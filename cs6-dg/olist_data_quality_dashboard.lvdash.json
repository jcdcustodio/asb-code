{
  "datasets": [
    {
      "name": "dataset1",
      "displayName": "data_quality_metrics",
      "config": {
        "version": "1.1",
        "source": "asb.semantic.data_quality_metrics",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ]
      }
    },
    {
      "name": "42ca6bb9",
      "displayName": "data_quality_result",
      "config": {
        "version": "1.1",
        "source": "asb.quarantine.audit_pipeline_runs",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "passing_rate",
            "expr": "SUM(source.records_passed) / SUM(source.total_evaluated)",
            "displayName": "Passing Rate"
          },
          {
            "name": "failure_rate",
            "expr": "SUM(source.records_quarantined) / SUM(source.total_evaluated)",
            "displayName": "Failure Rate"
          }
        ]
      }
    },
    {
      "name": "fa3058a0",
      "displayName": "data_quality_summary",
      "queryLines": [
        "SELECT \r\n",
        "    entity_name,\r\n",
        "    total_evaluated,\r\n",
        "    records_passed,\r\n",
        "    records_quarantined,\r\n",
        "    (records_passed / NULLIF(total_evaluated, 0)) * 100 AS pass_rate_pct,\r\n",
        "    (records_quarantined / NULLIF(total_evaluated, 0)) * 100 AS failure_rate_pct\r\n",
        "FROM asb.quarantine.audit_pipeline_runs\r\n",
        ";"
      ]
    },
    {
      "name": "pass_fail_by_entity",
      "displayName": "pass_fail_by_entity",
      "config": {
        "version": "1.1",
        "source": "SELECT entity_name, status, records,\n       records * 1.0 / SUM(records) OVER (PARTITION BY entity_name) AS pct\nFROM (\n  SELECT entity_name, 'passed' AS status, records_passed AS records\n  FROM asb.quarantine.audit_pipeline_runs\n  UNION ALL\n  SELECT entity_name, 'quarantined' AS status, records_quarantined AS records\n  FROM asb.quarantine.audit_pipeline_runs\n)\n",
        "dimensions": [
          {
            "name": "entity_name",
            "expr": "source.entity_name"
          },
          {
            "name": "status",
            "expr": "source.status"
          }
        ],
        "measures": [
          {
            "name": "record_share",
            "expr": "SUM(source.pct)",
            "displayName": "Record Share"
          },
          {
            "name": "record_count",
            "expr": "SUM(source.records)",
            "displayName": "Record Count"
          }
        ]
      }
    }
  ],
